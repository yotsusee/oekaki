<div style="text-align:center; margin-top: 20px;">
  
  <div class="mb-3">
    <strong>お題：</strong>
    <span id="odaiMessage"></span>
  </div>

  <!-- スタートボタン -->
  <div style="margin-bottom: 10px;">
    <button id="startBtn">スタート</button>
  <span id="countdown" style="margin-left: 10px; font-size: 20px;"></span>
  </div>


  <!-- パレット -->
  <div style="margin-bottom: 10px;">
    色：
    <input type="color" id="colorPicker" value="#000000">

    太さ：
    <input type="range" id="sizePicker" min="1" max="20" value="3">

    <button id="eraserBtn" class="btn btn-secondary">消しゴム</button>
    <button id="penBtn" class="btn btn-primary">ペン</button>
    <button id="clearCanvas" class="btn btn-danger">クリア</button>
  </div>

  <canvas id="drawingCanvas" width="600" height="400" style="border:1px solid #000;"></canvas>

  <div class="mt-3">
  <label for="titleInput">タイトル</label>
  <input type="text" id="titleInput" class="form-control" placeholder="絵のタイトルを入力">
</div>

<div class="mt-2">
  <button id="saveBtn" class="btn btn-primary">保存する</button>
</div>

<div id="saveMessage" class="mt-2 text-success"></div>

</div>
